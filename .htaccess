# ==========================================================
# Apache Security Configuration - Root
# ==========================================================

# Prevent Directory Browsing
Options -Indexes

# Protect Sensitive Files and Hidden Files
<FilesMatch "^\.|\.(env|log|sql|ini|sh|bak|md|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect Internal Directories from Direct Access
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive directories
    RewriteRule ^(config|scripts|app|database|src|storage|tests|vendor|docs|tools|\.agents|\.git)(/|$) - [F,L]

    # Fallback rewrite to public/ folder for subfolder access
    RewriteRule ^$ public/ [L]
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

# Security HTTP Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
