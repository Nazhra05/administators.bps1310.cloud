# ==========================================================
# Git Ignore Configuration - BPS Solok Selatan Admin
# ==========================================================

# Environment variables & local secrets
.env
.env.*
!.env.example

# Composer & Node dependencies
vendor/
node_modules/
package-lock.json

# Storage and uploads
storage/logs/*
!storage/logs/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/1790220841_logo bps solsel.jpg

# Database dumps (only schema, migrations, and seeds are allowed in repo)
database/*.sql
!database/schema.sql
!database/migrations/
!database/seeds/

# Logs and error reports
*.log
scripts/*.log
/logs/

# Test cache & temporary data
.phpunit.cache/
.php-cs-fixer.cache
.vitest/

# Backup & temporary files
*.tmp
*.bak
*.swp
*~

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
