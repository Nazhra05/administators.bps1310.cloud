# ==============================================================================
# BPS Solok Selatan - Dashboard Admin Environment Configuration Template
# ==============================================================================
# Salin file ini menjadi `.env` pada server Anda (baik Lokal XAMPP maupun VPS).
# JANGAN PERNAH meng-commit file `.env` asli yang berisi password ke Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
APP_NAME="Dashboard Admin BPS Solok Selatan"

# Mode aplikasi:
# - Lokal: 'development' (menampilkan pesan error jika ada)
# - VPS: 'production' (menyembunyikan pesan error internal)
APP_ENV=production
APP_DEBUG=false

# URL dasar aplikasi (sesuaikan domain/IP VPS atau path lokal):
# - Contoh Lokal: http://localhost/administators.bps1310.cloud/public
# - Contoh VPS: https://administators.bps1310.cloud
APP_URL=https://administators.bps1310.cloud


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# [Konfigurasi di VPS]:
# - DB_HOST: 127.0.0.1 (atau localhost)
# - DB_PORT: 3306
# - DB_NAME: bps-solsel (atau nama database yang dibuat di cPanel/VPS)
# - DB_USER: nama_user_database_vps
# - DB_PASS: password_database_vps_anda
#
# [Konfigurasi di Lokal XAMPP]:
# - DB_HOST: 127.0.0.1
# - DB_PORT: 3306
# - DB_NAME: bps-solsel
# - DB_USER: root
# - DB_PASS: (dikosongkan)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bps-solsel
DB_USER=your_db_username
DB_PASS=your_db_password


# ------------------------------------------------------------------------------
# 3. API CONFIGURATION & CORS
# ------------------------------------------------------------------------------
API_KEY=BPS_SOLSEL_API_2026_GANTI_DENGAN_KEY_RAHASIA_ANDA
API_URL=https://administators.bps1310.cloud/api/layanan.php

# Domain/origin frontend yang diizinkan (pisahkan dengan koma):
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://administators.bps1310.cloud


# ------------------------------------------------------------------------------
# 4. GMAIL SMTP (EMAIL VERIFIKASI & NOTIFIKASI ADMIN)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_gmail_email@gmail.com
SMTP_FROM_NAME="BPS Kabupaten Solok Selatan"


# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (TRENDING TOPICS GENERATOR)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
