# ==========================================================
# BPS Solok Selatan - Dashboard Admin Environment Config
# Copy this file to .env and adjust the values for your setup
# NEVER commit the actual .env file with secrets to Git!
# ==========================================================

# Application Settings
APP_NAME="Dashboard Admin BPS Solok Selatan"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://administators.bps1310.cloud

# Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bps_solsel
DB_USER=your_db_username
DB_PASS=your_db_password

# API Settings
API_KEY=BPS_SOLSEL_API_2026_CHANGE_THIS_TO_SECURE_RANDOM_KEY
API_URL=https://administators.bps1310.cloud/api/layanan.php
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gmail SMTP Configuration (for verification & notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="BPS Kabupaten Solok Selatan"

# Google Gemini API (for automated trending topics generation)
GEMINI_API_KEY=your_gemini_api_key_here
