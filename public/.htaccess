Options -Indexes -MultiViews
RewriteEngine On

# Blokir berkas tersembunyi dan ekstensi sensitif
<FilesMatch "^\.|\.(sql|log|bak|old|ini|md|lock|sh|env)$">
    Require all denied
</FilesMatch>

# Blokir akses langsung ke berkas .php fisik selain index.php
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} !index\.php$
RewriteCond %{REQUEST_URI} \.(php|phtml|phar)$
RewriteRule ^ - [F]

# Bukan berkas atau folder nyata -> front controller index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
